# Copy this file to ".env" and fill in your real key. ".env" is gitignored —
# it will never be committed. Do NOT paste your key anywhere public.

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...your-key-here...

# --- optional overrides (sensible defaults if omitted) ---
# Image model. gpt-image-1 supports transparent backgrounds (best for sprites).
# If your account only has DALL·E access, set: dall-e-3
ASSET_MODEL=gpt-image-1

# gpt-image-1: low | medium | high | auto    (dall-e-3: standard | hd)
ASSET_QUALITY=medium
